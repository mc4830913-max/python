import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns      
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.datasets import fetch_california_housing      

house=fetch_california_housing()
print(house.target)       
print(house.DESCR)  
print(house.feature_names)          


# prepare the dataset                     
df=pd.DataFrame(house.data,columns=house.feature_names)
df["price"]=house.target

print(df.sample(5))   

print(df.info())          

print(df.describe())                                                                                       


# EDA- exploratort data analysis  correlation is between(-1 to 1)
print(df.corr())

sns.pairplot(df)

fig,ax=plt.subplots(figsize=(15,15))
sns.boxplot(data=df,ax=ax)
plt.show()

###traing the model

x=df.iloc[:,:-1]     ## spliting the dataset into dependen and independt varibales
y=df.iloc[:,-1]
print(x)
print(y)

x_train,x_test,y_train,y_test=train_test_split(x,y,test_size=0.3,random_state=42)

scalar=StandardScaler()
x_train_norm=scalar.fit_transform(x_train)
x_test_norm=scalar.transform(x_test)

fig,ax=plt.subplots(figsize=(15,15))
sns.boxplot(data=x_train_norm,ax=ax)
plt.show()

from sklearn.linear_model import LinearRegression
regression=LinearRegression()
print(regression.fit(x_train_norm,y_train))


print(regression.coef_)
print(regression.intercept_)

###prediction of model
reg_pred=regression.predict(x_test_norm)
print("prediction" ,reg_pred)


## calcukate the error and esidual
residuals=y_test-reg_pred
print(residuals)

sns.displot(residuals,kind="kde")
plt.show()


## model performance
from sklearn.metrics import mean_absolute_error,mean_squared_error,r2_score
print(mean_squared_error(y_test,reg_pred))
print(mean_absolute_error(y_test,reg_pred))

score=r2_score(y_test,reg_pred)
print(score)

## adjusted squared value 
adjusted=1-(1-score)*(len(y_test)-1)/(len(y_test)-x_test_norm.shape[1]-1)
print(adjusted)


## save the model-> pickle file
import pickle
pickle.dump(regression,open("model.pkl","wb"))

model=pickle.load(open("model.pkl","rb"))

print(model.predict(x_test_norm))
